From d5854b48a3712c666c5459fb5074bd2a247d0990 Mon Sep 17 00:00:00 2001
From: Matthew Joyce <matthew.joyce@refeyn.com>
Date: Wed, 19 Jul 2023 14:52:59 +0100
Subject: [PATCH] Add SPI bus 3 with the 8 CS pins, two LEDs and remaining GPIO
 for the KMP test board

---
 arch/arm64/boot/dts/freescale/imx8qm-mek.dts | 171 ++++++++++++-------
 1 file changed, 109 insertions(+), 62 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8qm-mek.dts b/arch/arm64/boot/dts/freescale/imx8qm-mek.dts
index 2684250973fd..4e8ba4a909a9 100755
--- a/arch/arm64/boot/dts/freescale/imx8qm-mek.dts
+++ b/arch/arm64/boot/dts/freescale/imx8qm-mek.dts
@@ -7,6 +7,7 @@
 /dts-v1/;
 
 #include <dt-bindings/usb/pd.h>
+#include <dt-bindings/leds/common.h>
 #include "imx8qm.dtsi"
 
 / {
@@ -151,15 +152,6 @@ linux,cma {
 
 	};
 
-	reg_fec2_supply: fec2_nvcc {
-		compatible = "regulator-fixed";
-		regulator-name = "fec2_nvcc";
-		regulator-min-microvolt = <1800000>;
-		regulator-max-microvolt = <1800000>;
-		gpio = <&max7322 0 GPIO_ACTIVE_HIGH>;
-		enable-active-high;
-	};
-
 	reg_pciea: regulator-pcie {
 		compatible = "regulator-fixed";
 		pinctrl-names = "default";
@@ -408,6 +400,29 @@ rsc_table1: rsc-table@901ff000 {
 			no-map;
 		};
 	};
+
+	led-controller {
+		compatible = "gpio-leds";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_leds>;
+
+		led@0 {
+			function = LED_FUNCTION_INDICATOR;
+			color = <LED_COLOR_ID_GREEN>;
+			linux,default-trigger = "heartbeat";
+			panic-indicator;
+			gpios = <&lsio_gpio2 8 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+
+		led@1 {
+			function = LED_FUNCTION_STATUS;
+			color = <LED_COLOR_ID_RED>;
+			linux,default-trigger = "none";
+			gpios = <&lsio_gpio2 9 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+	};
 };
 
 &lsio_mu5 {
@@ -871,13 +886,20 @@ lvds1_out: endpoint {
 	};
 };
 
-&lpspi2 {
+&lpspi3 {
 	#address-cells = <1>;
 	#size-cells = <0>;
-	fsl,spi-num-chipselects = <1>;
+	fsl,spi-num-chipselects = <5>;
 	pinctrl-names = "default";
-	pinctrl-0 = <&pinctrl_lpspi2 &pinctrl_lpspi2_cs>;
-	cs-gpios = <&lsio_gpio3 10 GPIO_ACTIVE_LOW>;
+	pinctrl-0 = <&pinctrl_lpspi3 &pinctrl_lpspi3_cs>;
+	cs-gpios = <&lsio_gpio2 20 GPIO_ACTIVE_LOW>,
+		<&lsio_gpio2 21 GPIO_ACTIVE_LOW>,
+		<&lsio_gpio3 5 GPIO_ACTIVE_LOW>,
+		<&lsio_gpio3 24 GPIO_ACTIVE_LOW>,
+		<&lsio_gpio3 10 GPIO_ACTIVE_LOW>,
+		<&lsio_gpio6 14 GPIO_ACTIVE_LOW>,
+		<&lsio_gpio6 15 GPIO_ACTIVE_LOW>,
+		<&lsio_gpio6 16 GPIO_ACTIVE_LOW>;
 	status = "okay";
 
 	spidev0: spi@0 {
@@ -885,6 +907,48 @@ spidev0: spi@0 {
 		compatible = "rohm,dh2228fv";
 		spi-max-frequency = <30000000>;
 	};
+
+	spidev1: spi@1 {
+		reg = <1>;
+		compatible = "rohm,dh2228fv";
+		spi-max-frequency = <30000000>;
+	};
+
+	spidev2: spi@2 {
+		reg = <2>;
+		compatible = "rohm,dh2228fv";
+		spi-max-frequency = <2000000>;
+	};
+
+	spidev3: spi@3 {
+		reg = <3>;
+		compatible = "rohm,dh2228fv";
+		spi-max-frequency = <500000>;
+	};
+
+	spidev4: spi@4 {
+		reg = <4>;
+		compatible = "rohm,dh2228fv";
+		spi-max-frequency = <500000>;
+	};
+
+	spidev5: spi@5 {
+		reg = <5>;
+		compatible = "rohm,dh2228fv";
+		spi-max-frequency = <500000>;
+	};
+
+	spidev6: spi@6 {
+		reg = <6>;
+		compatible = "rohm,dh2228fv";
+		spi-max-frequency = <500000>;
+	};
+
+	spidev7: spi@7 {
+		reg = <7>;
+		compatible = "rohm,dh2228fv";
+		spi-max-frequency = <500000>;
+	};
 };
 
 &emvsim0 {
@@ -965,34 +1029,9 @@ vddio0: vddio-regulator {
 				regulator-max-microvolt = <1800000>;
 			};
 		};
-
-		ethphy1: ethernet-phy@1 {
-			compatible = "ethernet-phy-ieee802.3-c22";
-			reg = <1>;
-			qca,disable-smarteee;
-			vddio-supply = <&vddio1>;
-
-			vddio1: vddio-regulator {
-				regulator-min-microvolt = <1800000>;
-				regulator-max-microvolt = <1800000>;
-			};
-		};
 	};
 };
 
-&fec2 {
-	pinctrl-names = "default";
-	pinctrl-0 = <&pinctrl_fec2>;
-	phy-mode = "rgmii-txid";
-	phy-handle = <&ethphy1>;
-	phy-supply = <&reg_fec2_supply>;
-	fsl,magic-packet;
-	nvmem-cells = <&fec_mac1>;
-	nvmem-cell-names = "mac-address";
-	rx-internal-delay-ps = <2000>;
-	status = "okay";
-};
-
 &flexspi0 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_flexspi0>;
@@ -1424,6 +1463,25 @@ IMX8QM_ESAI0_TX5_RX0_AUD_ESAI0_TX5_RX0			0xc6000040
 		>;
 	};
 
+	pinctrl_leds: ledsgrp {
+		fsl,pins = <
+			IMX8QM_ESAI1_TX0_LSIO_GPIO2_IO08			0x06000040
+			IMX8QM_ESAI1_TX1_LSIO_GPIO2_IO09			0x06000040
+			// Bit of a hack including all of these additional GPIOs here, but it shunts them into the right mode
+			IMX8QM_ESAI1_TX2_RX3_LSIO_GPIO2_IO10			0x06000040
+			IMX8QM_ESAI1_TX3_RX2_LSIO_GPIO2_IO11			0x06000040
+			IMX8QM_ENET1_RGMII_TXC_LSIO_GPIO6_IO10			0x06000040
+			IMX8QM_ENET1_RGMII_TX_CTL_LSIO_GPIO6_IO11		0x06000040
+			IMX8QM_ENET1_RGMII_TXD0_LSIO_GPIO6_IO12			0x06000040
+			IMX8QM_ENET1_RGMII_TXD1_LSIO_GPIO6_IO13			0x06000040
+			IMX8QM_ENET1_RGMII_RX_CTL_LSIO_GPIO6_IO17		0x06000040
+			IMX8QM_ENET1_RGMII_RXD0_LSIO_GPIO6_IO18			0x06000040
+			IMX8QM_ENET1_RGMII_RXD1_LSIO_GPIO6_IO19			0x06000040
+			IMX8QM_ENET1_RGMII_RXD2_LSIO_GPIO6_IO20			0x06000040
+			IMX8QM_ENET1_RGMII_RXD3_LSIO_GPIO6_IO21			0x06000040
+		>;
+	};
+
 	pinctrl_fec1: fec1grp {
 		fsl,pins = <
 			IMX8QM_COMP_CTL_GPIO_1V8_3V3_ENET_ENETB_PAD		0x000014a0
@@ -1444,24 +1502,6 @@ IMX8QM_ENET0_RGMII_RXD3_CONN_ENET0_RGMII_RXD3		0x06000020
 		>;
 	};
 
-	pinctrl_fec2: fec2grp {
-		fsl,pins = <
-			IMX8QM_COMP_CTL_GPIO_1V8_3V3_ENET_ENETA_PAD		0x000014a0
-			IMX8QM_ENET1_RGMII_TX_CTL_CONN_ENET1_RGMII_TX_CTL	0x00000060
-			IMX8QM_ENET1_RGMII_TXC_CONN_ENET1_RGMII_TXC		0x00000060
-			IMX8QM_ENET1_RGMII_TXD0_CONN_ENET1_RGMII_TXD0		0x00000060
-			IMX8QM_ENET1_RGMII_TXD1_CONN_ENET1_RGMII_TXD1		0x00000060
-			IMX8QM_ENET1_RGMII_TXD2_CONN_ENET1_RGMII_TXD2		0x00000060
-			IMX8QM_ENET1_RGMII_TXD3_CONN_ENET1_RGMII_TXD3		0x00000060
-			IMX8QM_ENET1_RGMII_RXC_CONN_ENET1_RGMII_RXC		0x00000060
-			IMX8QM_ENET1_RGMII_RX_CTL_CONN_ENET1_RGMII_RX_CTL	0x00000060
-			IMX8QM_ENET1_RGMII_RXD0_CONN_ENET1_RGMII_RXD0		0x00000060
-			IMX8QM_ENET1_RGMII_RXD1_CONN_ENET1_RGMII_RXD1		0x00000060
-			IMX8QM_ENET1_RGMII_RXD2_CONN_ENET1_RGMII_RXD2		0x00000060
-			IMX8QM_ENET1_RGMII_RXD3_CONN_ENET1_RGMII_RXD3		0x00000060
-		>;
-	};
-
 	pinctrl_flexspi0: flexspi0grp {
 		fsl,pins = <
 			IMX8QM_QSPI0A_DATA0_LSIO_QSPI0A_DATA0     0x06000021
@@ -1531,17 +1571,24 @@ IMX8QM_GPT0_CAPTURE_LSIO_GPIO0_IO15	0xc600004c
 		>;
 	};
 
-	pinctrl_lpspi2: lpspi2grp {
+	pinctrl_lpspi3: lpspi3grp {
 		fsl,pins = <
-			IMX8QM_SPI2_SCK_DMA_SPI2_SCK		0x06000040
-			IMX8QM_SPI2_SDO_DMA_SPI2_SDO		0x06000040
-			IMX8QM_SPI2_SDI_DMA_SPI2_SDI		0x06000040
+			IMX8QM_SPI3_SCK_DMA_SPI3_SCK		0x06000040
+			IMX8QM_SPI3_SDO_DMA_SPI3_SDO		0x06000040
+			IMX8QM_SPI3_SDI_DMA_SPI3_SDI		0x06000040
 		>;
 	};
 
-	pinctrl_lpspi2_cs: lpspi2cs {
+	pinctrl_lpspi3_cs: lpspi3cs {
 		fsl,pins = <
-			IMX8QM_SPI2_CS0_LSIO_GPIO3_IO10		0x21
+			IMX8QM_SPI3_CS0_LSIO_GPIO2_IO20			0x20
+			IMX8QM_SPI3_CS1_LSIO_GPIO2_IO21			0x20
+			IMX8QM_SPI0_CS0_LSIO_GPIO3_IO05			0x20
+			IMX8QM_ADC_IN6_LSIO_GPIO3_IO24			0x20
+			IMX8QM_SPI2_CS0_LSIO_GPIO3_IO10			0x20
+			IMX8QM_ENET1_RGMII_TXD2_LSIO_GPIO6_IO14		0x20
+			IMX8QM_ENET1_RGMII_TXD3_LSIO_GPIO6_IO15		0x20
+			IMX8QM_ENET1_RGMII_RXC_LSIO_GPIO6_IO16		0x20
 		>;
 	};
 
