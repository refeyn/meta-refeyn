From e775d2c285ac77027a3dd54bb824b225695eda7d Mon Sep 17 00:00:00 2001
From: Kas User <kas@example.com>
Date: Fri, 19 May 2023 10:47:46 +0100
Subject: [PATCH] Work around native/target include path confusion

---
 sources/pyside6/cmake/Macros/PySideModules.cmake | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/sources/pyside6/cmake/Macros/PySideModules.cmake b/sources/pyside6/cmake/Macros/PySideModules.cmake
index cca66be8e..b8fcea0fe 100644
--- a/sources/pyside6/cmake/Macros/PySideModules.cmake
+++ b/sources/pyside6/cmake/Macros/PySideModules.cmake
@@ -103,8 +103,7 @@ macro(create_pyside_module)
     # Add QtCore since include conventions are sometimes violated for its classes
     get_target_property(qt_core_includes Qt${QT_MAJOR_VERSION}::Core
                         INTERFACE_INCLUDE_DIRECTORIES)
-    set(shiboken_include_dir_list ${pyside6_SOURCE_DIR} ${qt_platform_includes}
-        ${qt_core_includes})
+    set(shiboken_include_dir_list ${pyside6_SOURCE_DIR} ${QT_HOST_PATH}/include ${QT_HOST_PATH}/include/QtCore)
 
     # Transform the path separators into something shiboken understands.
     make_path(shiboken_include_dirs ${shiboken_include_dir_list})
