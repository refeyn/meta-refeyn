Date: Wed, 18 Sep 2024 11:30:49 +0100
Subject: [PATCH] Fix cross-comilation

---
 QuickGraphLib/CMakeLists.txt            |  2 +
 QuickGraphLib/bindings/CMakeLists.txt   | 99 ++++++++++++++-----------
 QuickGraphLib/bindings/pyside_config.py |  2 +-
 pyproject.toml                          |  2 +-
 4 files changed, 59 insertions(+), 46 deletions(-)

diff --git a/QuickGraphLib/CMakeLists.txt b/QuickGraphLib/CMakeLists.txt
index dd59c0b..cdd9ed3 100644
--- a/QuickGraphLib/CMakeLists.txt
+++ b/QuickGraphLib/CMakeLists.txt
@@ -67,10 +67,12 @@ add_custom_target(QuickGraphLibPythonFiles ALL DEPENDS ${QGL_PYTHON_FILES})
 install(
     TARGETS QuickGraphLib
     RUNTIME DESTINATION ${INSTALL_SUBPATH}/QuickGraphLib
+    LIBRARY DESTINATION ${INSTALL_SUBPATH}/QuickGraphLib
 )
 install(
     TARGETS QuickGraphLibPlugin
     RUNTIME DESTINATION ${INSTALL_SUBPATH}/QuickGraphLib
+    LIBRARY DESTINATION ${INSTALL_SUBPATH}/QuickGraphLib
 )
 install(FILES ${QGL_QML_FILES} DESTINATION ${INSTALL_SUBPATH}/QuickGraphLib)
 install(
diff --git a/QuickGraphLib/bindings/CMakeLists.txt b/QuickGraphLib/bindings/CMakeLists.txt
index d1cb8c1..045ec80 100644
--- a/QuickGraphLib/bindings/CMakeLists.txt
+++ b/QuickGraphLib/bindings/CMakeLists.txt
@@ -3,7 +3,7 @@
 # SPDX-License-Identifier: BSD-3-Clause
 
 set(CMAKE_PROGRAM_PATH "${CMAKE_PROGRAM_PATH};${CMAKE_SOURCE_DIR}/venv/Scripts")
-find_package(Python COMPONENTS Interpreter Development.SABIModule REQUIRED)
+find_package(Python COMPONENTS Interpreter Development.Module REQUIRED)
 
 # Macro to get various pyside / python include / link flags and paths.
 # Uses the not entirely supported utils/pyside_config.py file.
@@ -34,16 +34,23 @@ macro(pyside_config option output_var)
 endmacro()
 
 # Query for the shiboken generator path, Python path, include paths and linker flags.
-pyside_config(--shiboken-generator-path shiboken_generator_path)
-pyside_config(--pyside-path pyside_path)
-pyside_config(--pyside-include-path pyside_include_dir 1)
-pyside_config(--shiboken-generator-include-path shiboken_include_dir 1)
-pyside_config(--shiboken-module-shared-libraries-cmake shiboken_shared_libraries 0)
-pyside_config(--pyside-shared-libraries-cmake pyside_shared_libraries 0)
-
-set(shiboken_path
-    "${shiboken_generator_path}/shiboken6${CMAKE_EXECUTABLE_SUFFIX}"
-)
+# pyside_config(--shiboken-generator-path shiboken_generator_path)
+# pyside_config(--pyside-path pyside_path)
+# pyside_config(--pyside-include-path pyside_include_dir 1)
+# pyside_config(--shiboken-generator-include-path shiboken_include_dir 1)
+# pyside_config(--shiboken-module-shared-libraries-cmake shiboken_shared_libraries 0)
+# pyside_config(--pyside-shared-libraries-cmake pyside_shared_libraries 0)
+find_program(shiboken_path NAMES shiboken6 REQUIRED)
+find_path(pyside_typesystems_path NAMES PySide6/typesystems PATH_SUFFIXES share REQUIRED)
+find_path(shiboken_include_dir NAMES sbkpython.h PATH_SUFFIXES shiboken6 REQUIRED)
+find_path(pyside_include_dir NAMES pyside.h PATH_SUFFIXES PySide6 REQUIRED)
+find_library(shiboken_shared_libraries NAMES shiboken6 shiboken6.abi3 REQUIRED)
+find_library(pyside_shared_library NAMES pyside6 pyside6.abi3 REQUIRED)
+find_library(pyside_qml_shared_library NAMES pyside6qml pyside6qml.abi3 REQUIRED)
+
+# set(shiboken_path
+#     "${shiboken_generator_path}/shiboken6${CMAKE_EXECUTABLE_SUFFIX}"
+# )
 if(NOT EXISTS ${shiboken_path})
     message(
         FATAL_ERROR
@@ -62,22 +69,22 @@ endif()
 
 # Set up the options to pass to shiboken.
 set(INCLUDES "")
-get_property(
-    QT_CORE_INCLUDE_DIRS
-    TARGET Qt6::Core
-    PROPERTY INTERFACE_INCLUDE_DIRECTORIES
-)
-foreach(INCLUDE_DIR ${QT_CORE_INCLUDE_DIRS})
-    list(APPEND INCLUDES "-I${INCLUDE_DIR}")
-endforeach()
-get_property(
-    QT_GUI_INCLUDE_DIRS
-    TARGET Qt6::Gui
-    PROPERTY INTERFACE_INCLUDE_DIRECTORIES
-)
-foreach(INCLUDE_DIR ${QT_GUI_INCLUDE_DIRS})
-    list(APPEND INCLUDES "-I${INCLUDE_DIR}")
-endforeach()
+# get_property(
+#     QT_CORE_INCLUDE_DIRS
+#     TARGET Qt6::Core
+#     PROPERTY INTERFACE_INCLUDE_DIRECTORIES
+# )
+# foreach(INCLUDE_DIR ${QT_CORE_INCLUDE_DIRS})
+#     list(APPEND INCLUDES "-I${INCLUDE_DIR}")
+# endforeach()
+# get_property(
+#     QT_GUI_INCLUDE_DIRS
+#     TARGET Qt6::Gui
+#     PROPERTY INTERFACE_INCLUDE_DIRECTORIES
+# )
+# foreach(INCLUDE_DIR ${QT_GUI_INCLUDE_DIRS})
+#     list(APPEND INCLUDES "-I${INCLUDE_DIR}")
+# endforeach()
 
 # We need to include the headers for the module bindings that we use.
 set(pyside_additional_includes "")
@@ -93,10 +100,12 @@ set(shiboken_options
     --enable-return-value-heuristic
     --use-isnull-as-nb_nonzero
     --avoid-protected-hack
-    ${INCLUDES}
+    -I${QT_HOST_PATH}/include
+    -I${QT_HOST_PATH}/include/QtCore
+    -I${QT_HOST_PATH}/include/QtGui
     -I${CMAKE_SOURCE_DIR}
     -T${CMAKE_SOURCE_DIR}
-    -T${pyside_path}/typesystems
+    -T${pyside_typesystems_path}/PySide6/typesystems
     --output-directory=${CMAKE_CURRENT_BINARY_DIR}
     --compiler-path=${CMAKE_CXX_COMPILER}
 )
@@ -130,8 +139,8 @@ python_add_library(
     ShibokenHelpers.hpp
     ShibokenHelpers.cpp
     WITH_SOABI
-    USE_SABI
-    3.7
+    # USE_SABI
+    # 3.7
 )
 
 # Apply relevant include and link flags.
@@ -148,6 +157,8 @@ target_link_libraries(
     _QuickGraphLib
     PRIVATE
         ${pyside_shared_libraries}
+        ${pyside_shared_library}
+        ${pyside_qml_shared_library}
         ${shiboken_shared_libraries}
         QuickGraphLib
         Qt6::Core
@@ -155,19 +166,19 @@ target_link_libraries(
 )
 
 # Generate .pyi stub file
-set(pyi_path ${CMAKE_BINARY_DIR}/QuickGraphLib/_QuickGraphLib.pyi)
-add_custom_command(
-    OUTPUT ${pyi_path}
-    COMMAND
-        "${Python_EXECUTABLE}" ${CMAKE_CURRENT_SOURCE_DIR}/pyigen.py
-        $<TARGET_FILE:_QuickGraphLib> --outpath
-        ${CMAKE_BINARY_DIR}/QuickGraphLib
-    DEPENDS $<TARGET_FILE:_QuickGraphLib>
-    WORKING_DIRECTORY ${CMAKE_BINARY_DIR}
-    COMMENT "Running stub generation for for _QuickGraphLib."
-)
-
-add_custom_target(QuickGraphLibPythonStubs ALL DEPENDS ${pyi_path})
+# set(pyi_path ${CMAKE_BINARY_DIR}/QuickGraphLib/_QuickGraphLib.pyi)
+# add_custom_command(
+#     OUTPUT ${pyi_path}
+#     COMMAND
+#         "${Python_EXECUTABLE}" ${CMAKE_CURRENT_SOURCE_DIR}/pyigen.py
+#         $<TARGET_FILE:_QuickGraphLib> --outpath
+#         ${CMAKE_BINARY_DIR}/QuickGraphLib
+#     DEPENDS $<TARGET_FILE:_QuickGraphLib>
+#     WORKING_DIRECTORY ${CMAKE_BINARY_DIR}
+#     COMMENT "Running stub generation for for _QuickGraphLib."
+# )
+#
+# add_custom_target(QuickGraphLibPythonStubs ALL DEPENDS ${pyi_path})
 
 # Install files
 install(TARGETS _QuickGraphLib DESTINATION ${INSTALL_SUBPATH}/QuickGraphLib)
diff --git a/QuickGraphLib/bindings/pyside_config.py b/QuickGraphLib/bindings/pyside_config.py
index f40d67e..b76374d 100644
--- a/QuickGraphLib/bindings/pyside_config.py
+++ b/QuickGraphLib/bindings/pyside_config.py
@@ -189,7 +189,7 @@ def shared_library_suffix():
         return "dylib"
     # Linux
     else:
-        return "so.*"
+        return "so"
 
 
 def import_suffixes():
diff --git a/pyproject.toml b/pyproject.toml
index 672dfe6..628e61d 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -44,7 +44,7 @@ analyse = [
 ]
 
 [build-system]
-requires = ["scikit-build-core", "shiboken6_generator==6.5.3", "PySide6==6.5.3"]
+#requires = ["scikit-build-core"]
 build-backend = "scikit_build_core.build"
 
 [tool.scikit-build]
