From 2a6141a5bbb16fb23196f4b08fa534f912fa2fe6 Mon Sep 17 00:00:00 2001
From: Matthew Joyce <matthew.joyce@refeyn.com>
Date: Wed, 3 Jan 2024 15:39:37 +0000
Subject: [PATCH] Add touch via I2C

---
 arch/arm64/boot/dts/freescale/imx8qm-mek.dts | 16 +++++++++++++---
 arch/arm64/configs/imx_v8_defconfig          |  1 +
 2 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8qm-mek.dts b/arch/arm64/boot/dts/freescale/imx8qm-mek.dts
index 0cb036015c50..daa7f82edf4e 100755
--- a/arch/arm64/boot/dts/freescale/imx8qm-mek.dts
+++ b/arch/arm64/boot/dts/freescale/imx8qm-mek.dts
@@ -683,12 +683,22 @@ lvds0_out: endpoint {
 &i2c0_mipi0 {
 	#address-cells = <1>;
 	#size-cells = <0>;
-        pinctrl-names = "default";
-        pinctrl-0 = <&pinctrl_mipi0_lpi2c0>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_mipi0_lpi2c0>;
 	clock-frequency = <100000>;
 	status = "okay";
 
-	/// TODO
+	touchscreen@41 {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		compatible = "ilitek,ili251x";
+		reg = <0x41>;
+
+		interrupt-parent = <&lsio_gpio1>;
+		interrupts = <19 IRQ_TYPE_LEVEL_LOW>;
+		// reset-gpios = <&gpio1 8 GPIO_ACTIVE_LOW>;
+		wakeup-source;
+	};
 };
 
 &mipi0_dphy {
diff --git a/arch/arm64/configs/imx_v8_defconfig b/arch/arm64/configs/imx_v8_defconfig
index 8eb5e88c90f7..6882cf6cbd24 100644
--- a/arch/arm64/configs/imx_v8_defconfig
+++ b/arch/arm64/configs/imx_v8_defconfig
@@ -375,6 +375,7 @@ CONFIG_TOUCHSCREEN_ATMEL_MXT=m
 CONFIG_TOUCHSCREEN_EXC3000=m
 CONFIG_TOUCHSCREEN_GOODIX=m
 CONFIG_TOUCHSCREEN_EDT_FT5X06=m
+CONFIG_TOUCHSCREEN_ILI210X=y
 CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_I2C=m
 CONFIG_INPUT_MISC=y
 CONFIG_INPUT_PWM_BEEPER=m
